# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ROUTELLM_BASE_URL: Standart Abacus.AI RouteLLM API adresi (Zorunlu değer: https://routellm.abacus.ai/v1)
ROUTELLM_BASE_URL="https://routellm.abacus.ai/v1"

# ROUTELLM_API_KEY: Abacus.AI RouteLLM sunucu tarafı API anahtarı (En az 16 karakter, boşluksuz)
ROUTELLM_API_KEY=""

# TOTP_ENCRYPTION_KEY: 32 baytlık hexadecimal anahtar (Tam 64 hex karakter: 0-9, a-f). AES-256-GCM doğrulamalı şifreleme için kullanılır.
TOTP_ENCRYPTION_KEY=""

# SESSION_SECRET: Oturum yönetimi için en az 32 karakter (256-bit+) uzunluğunda yüksek entropili gizli anahtar.
SESSION_SECRET=""

# RESEND_WEBHOOK_SECRET: Resend Inbound Email (email.received) webhook imza doğrulama anahtarı ("whsec_" ile başlayan base64 dizge)
RESEND_WEBHOOK_SECRET=""

# RESEND_API_KEY: Resend gelen e-posta ve eklerini çekmek için kullanılan API anahtarı ("re_" ile başlayan dizge)
RESEND_API_KEY=""
